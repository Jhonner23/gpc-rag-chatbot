# ignore everything in the following folders
data/**

# except their sub-folders
!data/**/
!data/README.md

# GPC en PDF: se versionan (decision confirmada con la asesora) para que
# clonar el repo alcance -- sin depender de que cada quien tenga su copia
# aparte. Van en data/01_raw/gpc/ (convencion Kedro de este proyecto),
# que es exactamente lo que lee gpc_rag.pipelines.build_index.
!data/01_raw/gpc/*.pdf

# clonar el repo alcance, sin depender de que cada quien tenga su copia.

# also keep all .gitkeep files
!.gitkeep


# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
.venv
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
